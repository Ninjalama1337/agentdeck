# AgentDeck — systemd user service
#
# Installation: siehe docs/CONFIG.md ("systemd — User-Service"). Der Befehl
# dort traegt Checkout- und node-Pfad automatisch ein.
#
# Unveraendert kopiert erwartet die Unit den Checkout unter ~/agentdeck und
# node auf dem PATH des systemd-User-Managers (bei nvm/Homebrew oft nicht so).
# Logs: journalctl --user -u agentdeck -f

[Unit]
Description=AgentDeck server (remote control deck for coding agents)
Documentation=https://github.com/Ninjalama1337/agentdeck
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/agentdeck
ExecStart=/usr/bin/env node %h/agentdeck/server/dist/index.js
Environment=AGENTDECK_PORT=8787
Environment=NODE_ENV=production
# Optional: Log-Level und Bind-Adresse ueberschreiben (env > config.json)
# Environment=AGENTDECK_LOG_LEVEL=debug
# Environment=AGENTDECK_HOST=127.0.0.1

Restart=on-failure
RestartSec=3
# Nur den Server selbst beenden: die Terminals laufen in tmux unter diesem
# Dienst und sollen Neustart und Update ueberleben.
KillMode=process

# Bewusst ohne NoNewPrivileges/PrivateTmp: die Terminals und Agents laufen als
# Kinder dieses Dienstes und sollen sich wie eine normale Shell verhalten
# (sudo, gemeinsames /tmp).

[Install]
WantedBy=default.target
