{
  "name": "@agentdeck/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentDeck backend: Fastify API, socket.io gateway, agent adapters, MCP bridge.",
  "bin": {
    "agentdeck-mcp": "dist/mcp/bridge.js",
    "agentdeck-server": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && chmod +x dist/mcp/bridge.js dist/cli.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@agentdeck/shared": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^10.1.6",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "execa": "^9.5.1",
    "fastify": "^5.1.0",
    "jose": "^6.0.8",
    "nanoid": "^5.0.8",
    "node-pty": "^1.1.0",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
